<!DOCTYPE html>
<html>
<head>
  <title>Login - QX Inventory</title>
  <meta charset="UTF-8">
  <link rel="stylesheet" href="//netdna.bootstrapcdn.com/bootstrap/3.0.2/css/bootstrap.min.css">
  <link rel="stylesheet" href="//netdna.bootstrapcdn.com/font-awesome/4.0.3/css/font-awesome.min.css">
  <style>
    body {
      padding-top: 80px;
      background: url("/images/pic04.jpg") no-repeat center center fixed;
      background-size: cover;
      font-family: Arial, sans-serif;
      color: white;
    }

    .login-container {
      background-color: rgba(0, 0, 0, 0.6);
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 0 15px rgba(0,0,0,0.5);
    }

    .form-control {
      background-color: rgba(255, 255, 255, 0.85);
      color: #000;
    }

    .form-control::placeholder {
      color: #555;
    }

    .alert {
      color: white;
      background-color: #d9534f;
      border: none;
      padding: 10px;
      text-align: center;
    }

    h1 {
      color: #0787ff;
    }

    a {
      color: #ddd;
    }

    a:hover {
      color: #fff;
    }

    .footer {
      margin-top: 20px;
      font-size: 14px;
      color: #ccc;
      text-align: center;
    }

    button.btn {
      font-weight: bold;
    }
  </style>
</head>
<body>
<div class="container">
  <div class="col-sm-6 col-sm-offset-3 login-container">

    <h1><span class="fa fa-sign-in"></span> Login</h1>

    <% if (typeof error !== 'undefined' && error.length > 0) { %>
      <div class="alert alert-danger">
        <%= error %>
      </div>
    <% } %>

    <!-- LOGIN FORM -->
    <form action="/login" method="post">
      <div class="form-group">
        <label>Email</label>
        <input
          type="text"
          class="form-control"
          name="email"
          placeholder="Enter your email"
          value="<%= typeof email !== 'undefined' ? email : '' %>"
          required
        >
      </div>
      <div class="form-group">
        <label>Password</label>
        <input
          type="password"
          class="form-control"
          name="password"
          placeholder="Enter your password"
          required
        >
      </div>

      <button type="submit" class="btn btn-warning btn-lg btn-block">Login</button>
    </form>

    <hr>

    <p>Need an account? <a href="/register">Sign up</a></p>
    <p>Or go <a href="/homepage">home</a>.</p>

    <div class="footer">
      <p>&copy; <%= new Date().getFullYear() %> QX Inventory Management</p>
    </div>
  </div>
</div>
</body>
</html>
